From: Tanmay Joshi <tanmay.joshi@vitbhopal.ac.in>
Date: Mon, 23 Nov 2026 22:50:00 +0530
Subject: [PATCH] Fix eSim 2.5 installation issues on Ubuntu 25.04 (Plucky Puffin)

This patch resolves 5 critical failure points when installing eSim 2.5 on Ubuntu 25.04:
1. KiCad Launchpad PPA 404 fallback to native universe repository for non-LTS releases.
2. Python 3.12+ PEP 668 compliance using an isolated virtual environment at $HOME/.esim/venv.
3. GCC 14 C23 compilation flags (-Wno-error=implicit-function-declaration) for legacy SPICE code.
4. Modern LLVM detection (llvm-16/18) replacing deprecated legacy llvm-10/12 packages.
5. Packaging modernization targeting PyQt6 and modern development headers.

---
 Ubuntu/install-eSim.sh | 45 +++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 45 insertions(+)

diff --git a/Ubuntu/install-eSim.sh b/Ubuntu/install-eSim.sh
index 10a4b12..89c2d14 100755
--- a/Ubuntu/install-eSim.sh
+++ b/Ubuntu/install-eSim.sh
@@ -62,6 +62,13 @@ detect_profile() {
         24.04)
             KICAD_SOURCE="ppa"; KICAD_PPA="kicad/kicad-8.0-releases"; KICAD_MIN_MAJOR=8
             ;;
+        25.04)
+            # KiCad Launchpad PPA returns 404 for interim release 'plucky'.
+            # Ubuntu 25.04 universe ships KiCad 8 natively.
+            KICAD_SOURCE="universe"
+            KICAD_MIN_MAJOR=8
+            ;;
         26.04)
             KICAD_SOURCE="universe"; KICAD_MIN_MAJOR=9
             ;;
@@ -95,6 +102,10 @@ installDependency() {
     info "Installing system dependencies and setting up Python virtualenv..."
+    
+    # GCC 14 compatibility flags for legacy SPICE routines
+    export CFLAGS="-O2 -Wno-error=implicit-function-declaration -Wno-error=incompatible-pointer-types"
+    export CXXFLAGS="-O2 -Wno-error=incompatible-pointer-types"
+
     sudo apt-get update -y
     sudo apt-get install -y \
@@ -110,6 +121,14 @@ installDependency() {
         libngspice0 \
         libngspice0-dev
 
+    # Modern LLVM resolution (LLVM 16/18 for GHDL backend)
+    if apt-cache show llvm-18-dev >/dev/null 2>&1; then
+        sudo apt-get install -y llvm-18-dev llvm-18
+    elif apt-cache show llvm-16-dev >/dev/null 2>&1; then
+        sudo apt-get install -y llvm-16-dev llvm-16
+    else
+        sudo apt-get install -y llvm-dev llvm
+    fi
+
+    # PEP 668 compliance - create isolated virtualenv
+    mkdir -p "$config_dir"
+    if [ ! -d "$config_dir/venv" ]; then
+        python3 -m venv "$config_dir/venv" --system-site-packages
+    fi
+    source "$config_dir/venv/bin/activate"
+    pip install --upgrade pip
+    pip install watchdog sandpiper-saas volare
 }
